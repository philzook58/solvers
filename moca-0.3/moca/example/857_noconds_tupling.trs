(PROBLEM INFEASIBILITY)
(COMMENT COPS 335)
(CONDITIONTYPE ORIENTED)
(VAR x y q r)
(RULES
        div(0, s(x)) -> pair(0, 0)
        div(s(x), s(y)) -> pair(0, s(x))
        div(s(x), s(y)) -> pair(s(q), r)
        lt(0, s(x)) -> true
        lt(s(x), s(y)) -> lt(x, y)
        lt(x, 0) -> false
        m(0, s(y)) -> 0
        m(s(x), s(y)) -> m(x, y)
        m(x, 0) -> x
        t1(lt(x1, x2), lt(x1, x2), div(m(x1, x2), s(x2)), x3, x4) -> true__
        t1(true, false, pair(x3, x4), x3, x4) -> false__
)
(VAR )
(CONDITION true__ == false__)
(COMMENT submitted by: Naoki Nishida
)
