(PROBLEM INFEASIBILITY)
(COMMENT COPS 361)
(CONDITIONTYPE ORIENTED)
(VAR x y q r)
(RULES
 div(x, y) -> pair(0, y) | greater(y, x) == true
  div(x, y) -> pair(s(q), r) | leq(y, x) == true, div(m(x, y), y) == pair(q, r)
  m(x, 0) -> x
  m(0, y) -> 0
  m(s(x), s(y)) -> m(x, y)
  greater(s(x), s(y)) -> greater(x, y)
  greater(s(x), 0) -> true
  leq(s(x), s(y)) -> leq(x, y)
  leq(0, x) -> true
)
(VAR w x y z)
(CONDITION leq(x,w) == true, div(m(w,x),x) == pair(y,z), greater(x,w) == true)
(COMMENT [101] Example 5.1
submitted by: Raul Gutierrez and Salvador Lucas
)
